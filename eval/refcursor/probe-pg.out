CREATE PROCEDURE
== P1/P2: explicit transaction, cursors named by the caller, later DML invisible to the first cursor
BEGIN
rs1|rs2
1|a
2|b
3|c
-- second
1|changed
2|b
4|new
COMMIT
TRUNCATE TABLE
