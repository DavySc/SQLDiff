// Inputs dumped by the Rust edit checker (one instance c per sweep call).
.decl unit(c:number, u:number, s:number, e:number, jumps:number)
.decl reads(c:number, u:number, n:number)
.decl writes(c:number, u:number, n:number)
.decl touches(c:number, u:number, n:number)
.decl status(c:number, n:number)
.decl fspan(c:number, a:number, b:number)          // spans of every non-equal finding
.decl edit(c:number, j:number, at:number, h0:number, h1:number)
.decl dspan(c:number, j:number, a:number, b:number) // deciding conditions of edit j
.input unit, reads, writes, touches, status, fspan, edit, dspan

// A unit is changed when it overlaps a finding's span (strict overlap).
.decl changed(c:number, u:number)
changed(c,u) :- unit(c,u,s,e,_), fspan(c,a,b), s < b, a < e.
.decl unchanged(c:number, u:number)
unchanged(c,u) :- unit(c,u,_,_,_), !changed(c,u).
.decl hasreads(c:number, u:number)
hasreads(c,u) :- reads(c,u,_).

// Spans an edit's taint answer looks at: its deciding conditions and itself.
.decl qspan(c:number, j:number, a:number, b:number)
qspan(c,j,a,b) :- dspan(c,j,a,b).
qspan(c,j,a,b) :- edit(c,j,_,a,b).
.decl needed(c:number, j:number, n:number)
needed(c,j,n) :- qspan(c,j,a,b), unit(c,u,s,e,_), s < b, a < e, reads(c,u,n).

// Edit ranges' own units, whose writes seed the reach half.
.decl seed(c:number, j:number, x:number)
seed(c,j,x) :- ask(c,j), edit(c,j,_,a,b), unit(c,u,s,e,_), s < b, a < e, writes(c,u,x), !status(c,x).
.decl ask(c:number, j:number)
ask(c,j) :- edit(c,j,_,_,_), !meets(c,j).
.decl meets(c:number, j:number)

// first_change / jump: changed units ending at or before the edit's start.
.decl ans_fc(c:number, j:number, v:number)
ans_fc(c,j,v) :- edit(c,j,at,_,_), v = min s : { unit(c,u,s,e,_), changed(c,u), e <= at }.
.decl ans_jump(c:number, j:number, v:number)
ans_jump(c,j,v) :- edit(c,j,at,_,_), v = min s : { unit(c,u,s,e,1), changed(c,u), e <= at }.
.output ans_fc, ans_jump
