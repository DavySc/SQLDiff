// Callee propagation (convert/src/callees.rs::resolve) as stratified Datalog.
// Status ranks: 0 Converted, 1 Assumptions, 2 Decision, 3 Unproven, ...
.decl file(i:number, blocked:number, cyclic:number)
.decl unit0(i:number, u:number, s:number)
.decl anote0(i:number, u:number, r:symbol)
.decl dep(i:number, k:number)
.decl def(k:number, j:number)
.decl callok(i:number, k:number, u:number)    // calling units when the call holds
.decl callwide(i:number, k:number, u:number)  // calling units when it does not
.input file, unit0, anote0, dep, def, callok, callwide

.decl ndef(k:number, n:number)
ndef(k,n) :- dep(_,k), n = count : { def(k,_) }.
.decl only(k:number, j:number)
only(k,j) :- ndef(k,1), def(k,j).

// Cycles are given (the Rust code finds them before its loop too);
// cyccheck.dl recomputes them from the call graph.
.decl cyc(i:number)
cyc(i) :- file(i,_,1).

// Stratum 1: which calls fail. A file is bad when a unit is worse than
// Assumptions (before or through a failed call) or it is blocked.
.decl err(i:number, k:number)
.decl bad(j:number)
err(i,k) :- dep(i,k), !only(k,_).
err(i,k) :- dep(i,k), only(k,j), cyc(i), cyc(j).
err(i,k) :- dep(i,k), only(k,j), bad(j).
bad(j) :- unit0(j,_,s), s > 1.
bad(j) :- file(j,1,_).
bad(i) :- err(i,k), callwide(i,k,_).

// Stratum 2: calls that hold carry the callee file's assumption notes, transitively.
.decl ok(i:number, k:number, j:number)
ok(i,k,j) :- dep(i,k), only(k,j), !err(i,k).
.decl note(i:number, u:number, r:symbol)
note(i,u,r) :- anote0(i,u,r).
note(i,u,r) :- ok(i,k,j), callok(i,k,u), note(j,_,r).

.decl bump(i:number, u:number)
bump(i,u) :- ok(i,k,j), callok(i,k,u), note(j,_,r), !anote0(i,u,r).
.decl cand(i:number, u:number, s:number)
cand(i,u,s) :- unit0(i,u,s).
cand(i,u,1) :- bump(i,u).
cand(i,u,3) :- err(i,k), callwide(i,k,u).
.decl st(i:number, u:number, s:number)
st(i,u,s) :- unit0(i,u,_), s = max x : { cand(i,u,x) }.
.output st, note
